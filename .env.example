NEXT_PUBLIC_SUPABASE_URL=https://kltxwijhluawgveykfbt.supabase.co
SUPABASE_URL=https://kltxwijhluawgveykfbt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-project-anon-key
SUPABASE_SERVICE_ROLE_KEY=

TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
TRIGGER_ACCESS_TOKEN=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_WEBSITE_ANALYSIS_MODEL=gpt-4o-mini
OPENAI_CAROUSEL_PLANNER_MODEL=gpt-4o-mini
CAROUSEL_BROAD_MATCHER_MODE=off
CAROUSEL_DISABLE_CATEGORY_FALLBACK=true
FIRECRAWL_API_KEY=
GEMINI_API_KEY=
RUNWAYML_API_SECRET=
HEYGEN_API_KEY=

APP_BASE_URL=https://www.getugcpilot.com
# Private render-worker callback used to complete scheduling after a render.
UGC_INTERNAL_APP_URL=https://getugcpilot.com
# Optional dedicated override; otherwise a domain-separated key is derived from SUPABASE_SERVICE_ROLE_KEY.
UGC_INTERNAL_SCHEDULING_SECRET=
# Dedicated shared secret of at least 32 random bytes for the quarter-hour
# daily-Carousel replenishment task.
# Set the same value in Vercel and Trigger.dev; do not give Trigger.dev the
# Supabase service-role key just to use the fallback.
UGC_INTERNAL_CAROUSEL_SECRET=
# Optional; defaults to 15 minutes when unset or invalid.
SCHEDULING_MIN_RENDER_LEAD_MINUTES=15
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Legacy fallback while existing deployments rotate to SOCIAL_TOKEN_ENCRYPTION_KEY.
OAUTH_TOKEN_ENCRYPTION_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://getugcpilot.com/api/social/tiktok/callback
# TikTok uses the same OAuth endpoints; this marker prevents credential mixups.
TIKTOK_ENV=production
# FILE_UPLOAD avoids requiring TikTok ownership verification for the CloudFront URL.
TIKTOK_MEDIA_TRANSFER_MODE=FILE_UPLOAD
# Instagram Login OAuth. Use the values from Meta Dashboard > Instagram > API setup with Instagram login.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://getugcpilot.com/api/social/instagram/callback
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish,instagram_business_manage_insights
# Meta app secret is still used for the Meta data deletion signed request callback.
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://getugcpilot.com/api/social/youtube/callback
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube.readonly

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
CLOUDFRONT_DOMAIN=

# Optional deployment credentials for ECS/ECR/CloudWatch worker smoke tests.
# Prefer these over reusing app enqueue or S3 uploader credentials.
AWS_DEPLOY_ACCESS_KEY_ID=
AWS_DEPLOY_SECRET_ACCESS_KEY=
AWS_DEPLOY_SESSION_TOKEN=

# AWS app enqueue credentials for sending SQS jobs from Next.js.
# Keep these scoped to SQS enqueue permissions.
AWS_APP_ENQUEUE_ACCESS_KEY_ID=
AWS_APP_ENQUEUE_SECRET_ACCESS_KEY=

# AWS worker deployment config.
ECS_CLUSTER_NAME=
ECS_AI_GENERATION_TEMPLATE_TASK_DEFINITION=
WORKER_SECURITY_GROUP_ID=
WORKER_SUBNET_IDS=
ECR_REPOSITORY_URI=
WORKER_SECRET_ARN=
ECS_TASK_EXECUTION_ROLE_ARN=
ECS_TASK_ROLE_ARN=
CLOUDWATCH_LOG_GROUP=

# Per-worker runtime queue config. ECS services should set these explicitly.
# Example media worker:
# WORKER_QUEUE_URL=${UGC_MEDIA_PROCESSING_QUEUE_URL}
# WORKER_QUEUE_NAME=media-processing
# WORKER_JOB_TYPES=test_worker_job
# Example video render worker:
# WORKER_QUEUE_URL=${UGC_VIDEO_RENDER_QUEUE_URL}
# WORKER_QUEUE_NAME=video-render
# WORKER_JOB_TYPES=render_edit_video
# Example carousel worker:
# WORKER_QUEUE_URL=${UGC_CAROUSEL_QUEUE_URL}
# WORKER_QUEUE_NAME=carousel
# WORKER_JOB_TYPES=generate_carousel
WORKER_QUEUE_URL=
WORKER_QUEUE_NAME=
WORKER_JOB_TYPES=

# Durable social publishing retries and database reconciliation.
SOCIAL_PUBLISH_MAX_ATTEMPTS=4
SOCIAL_PUBLISH_RETRY_BASE_SECONDS=30
SOCIAL_PUBLISH_RETRY_MAX_SECONDS=900
SOCIAL_RECONCILIATION_BATCH_SIZE=10
SOCIAL_RECONCILIATION_INTERVAL_SECONDS=15
# Optional deployment overrides for the social-publish ECS profile.
ECS_SOCIAL_PUBLISH_MAX_ATTEMPTS=4
ECS_SOCIAL_PUBLISH_RECONCILIATION_BATCH_SIZE=10
ECS_SOCIAL_PUBLISH_RECONCILIATION_INTERVAL_SECONDS=15
ECS_SOCIAL_PUBLISH_RETRY_BASE_SECONDS=30
ECS_SOCIAL_PUBLISH_RETRY_MAX_SECONDS=900
# Set this only when WORKER_SECRET_ARN contains GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET.
ECS_SOCIAL_PUBLISH_USE_WORKER_SECRET_GOOGLE_OAUTH=false
# Optional alternative: inject Google OAuth values from dedicated Secrets Manager secrets.
ECS_SOCIAL_PUBLISH_GOOGLE_CLIENT_ID_SECRET_ARN=
ECS_SOCIAL_PUBLISH_GOOGLE_CLIENT_SECRET_SECRET_ARN=

# Optional ECS worker smoke-test overrides.
ECS_TEST_IMAGE_TAG=
ECS_TEST_IMAGE_URI=
ECS_TEST_SKIP_IMAGE_PUSH=false
ECS_TEST_MAX_TASK_RUNS=3
ECS_TEST_TIMEOUT_SECONDS=300
ECS_WORKER_ASSIGN_PUBLIC_IP=ENABLED
ECS_WORKER_CONTAINER_NAME=ugc-worker
ECS_WORKER_CPU=512
ECS_WORKER_MEMORY=1024
ECS_WORKER_LOG_STREAM_PREFIX=worker-smoke
ECS_WORKER_TASK_FAMILY=ugc-worker-test

# AWS worker SQS queues.
UGC_AI_GENERATION_QUEUE_URL=
UGC_AI_GENERATION_QUEUE_ARN=
UGC_AI_GENERATION_DLQ_ARN=
UGC_CAROUSEL_QUEUE_URL=
UGC_CAROUSEL_QUEUE_ARN=
UGC_CAROUSEL_DLQ_ARN=
UGC_VIDEO_RENDER_QUEUE_URL=
UGC_VIDEO_RENDER_QUEUE_ARN=
UGC_VIDEO_RENDER_DLQ_ARN=
UGC_MEDIA_PROCESSING_QUEUE_URL=
UGC_MEDIA_PROCESSING_QUEUE_ARN=
UGC_MEDIA_PROCESSING_DLQ_ARN=
UGC_SOCIAL_PUBLISH_QUEUE_URL=
UGC_SOCIAL_PUBLISH_QUEUE_ARN=
UGC_SOCIAL_PUBLISH_DLQ_ARN=

NEXT_PUBLIC_FIREBASE_API_KEY="your_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_app_domain.com"
NEXT_PUBLIC_FIREBASE_AUTH_HELPER_DOMAIN="your_project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_app_id"
