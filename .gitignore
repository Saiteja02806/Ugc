# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.trigger
/worker/dist/
/worker/node_modules/

# production
/build

# misc
.DS_Store
*.pem
*.log
/.agents/
/.codex/
/.chrome-carousel-upgrade-check/
/.playwright-mcp/
/.tmp/
/hatch-pet-runs/
/tmp/
/tmp-logs/
/local-run-logs/
/.tools/
/carousel-*.png
/carousel-*.webp
/ugc-home-*.png
/ugcpilot_logo__1.png

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# terraform local state and private variables
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
*.tfplan
crash.log
crash.*.log

# vercel
.vercel

# supabase local state
/supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts
