+export function normalizeSubscriptionPlanKey(
+  rawKey: string | null | undefined,
+): BillingPlanKey {
+  if (!rawKey) return "free";
+  const normalized = rawKey.trim().toLowerCase();
+
+  if (
+    normalized === "growth" ||
+    normalized === "creator" ||
+    normalized === "ultra_pro"
+  ) {
+    return "growth";
+  }
+
+  if (normalized === "starter" || normalized === "pro") {
+    return "starter";
+  }
+
+  return "free";
