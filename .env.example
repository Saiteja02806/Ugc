NEXT_PUBLIC_SUPABASE_URL=https://kltxwijhluawgveykfbt.supabase.co
SUPABASE_URL=https://kltxwijhluawgveykfbt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-project-anon-key
SUPABASE_SERVICE_ROLE_KEY=
# Optional expected Supabase project ref used by production migration audits.
# Defaults to the project ref parsed from SUPABASE_URL/NEXT_PUBLIC_SUPABASE_URL.
PRODUCTION_SUPABASE_PROJECT_REF=kltxwijhluawgveykfbt

OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_WEBSITE_ANALYSIS_MODEL=gpt-4o-mini
OPENAI_CAROUSEL_PLANNER_MODEL=gpt-4o-mini
# Optional; defaults to gpt-4o-mini for business-grounded Hook suggestions.
OPENAI_HOOK_SUGGESTION_MODEL=gpt-4o-mini
CAROUSEL_BROAD_MATCHER_MODE=off
CAROUSEL_DISABLE_CATEGORY_FALLBACK=true
FIRECRAWL_API_KEY=
GEMINI_API_KEY=
RUNWAYML_API_SECRET=
HEYGEN_API_KEY=

APP_BASE_URL=https://www.getugcpilot.com
# Private render-worker callback used to complete scheduling after a render.
UGC_INTERNAL_APP_URL=https://getugcpilot.com
# Optional dedicated override; otherwise a domain-separated key is derived from SUPABASE_SERVICE_ROLE_KEY.
UGC_INTERNAL_SCHEDULING_SECRET=
# Optional dedicated secret for the production GCP cutover audit route.
# When omitted, a domain-separated key is derived from SUPABASE_SERVICE_ROLE_KEY.
UGC_INTERNAL_CUTOVER_AUDIT_SECRET=
# Dedicated shared secret of at least 32 random bytes for the quarter-hour
# daily-Carousel replenishment task.
# Set the same value wherever the scheduler replacement runs; do not expose
# the Supabase service-role key merely to use the fallback.
UGC_INTERNAL_CAROUSEL_SECRET=
# Optional worker-side scheduler runner tuning.
CAROUSEL_REPLENISHMENT_PAGE_SIZE=5
CAROUSEL_REPLENISHMENT_REQUEST_TIMEOUT_MS=50000
# Optional; defaults to 15 minutes when unset or invalid.
SCHEDULING_MIN_RENDER_LEAD_MINUTES=15
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Legacy fallback while existing deployments rotate to SOCIAL_TOKEN_ENCRYPTION_KEY.
OAUTH_TOKEN_ENCRYPTION_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://getugcpilot.com/api/social/tiktok/callback
# TikTok uses the same OAuth endpoints; this marker prevents credential mixups.
TIKTOK_ENV=production
# FILE_UPLOAD avoids requiring TikTok ownership verification for the Cloud Storage URL.
TIKTOK_MEDIA_TRANSFER_MODE=FILE_UPLOAD
# Photo carousel posts use PULL_FROM_URL and require these hosts to be verified
# in the TikTok developer app. Use a comma-separated hostname list.
TIKTOK_VERIFIED_MEDIA_HOSTS=
# Instagram Login OAuth. Use the values from Meta Dashboard > Instagram > API setup with Instagram login.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://getugcpilot.com/api/social/instagram/callback
# Optional; only needed while the Meta data deletion signed request callback is enabled.
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://getugcpilot.com/api/social/youtube/callback

# GCP is the only runtime storage, queue, and scheduler platform.
GCP_PROJECT_ID=ugcsaas
GCP_REGION=us-central1
GCP_STORAGE_BUCKET=ugcsaas-media
GCP_STORAGE_PUBLIC_BASE_URL=https://storage.googleapis.com/ugcsaas-media
GCP_CLOUD_TASKS_LOCATION=us-central1
GCP_SOCIAL_PUBLISH_SCHEDULER_TASKS_QUEUE=ugc-social-publish-scheduler
GCP_AI_GENERATION_TASKS_QUEUE=ugc-ai-generation
GCP_CAROUSEL_TASKS_QUEUE=ugc-carousel
GCP_MEDIA_PROCESSING_TASKS_QUEUE=ugc-media-processing
GCP_SOCIAL_PUBLISH_TASKS_QUEUE=ugc-social-publish
GCP_VIDEO_RENDER_TASKS_QUEUE=ugc-video-render
GCP_CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=ugc-scheduler-sa@ugcsaas.iam.gserviceaccount.com
# Cloud Run service base URLs. The app appends /tasks/jobs.
GCP_AI_GENERATION_TASK_URL=
GCP_CAROUSEL_TASK_URL=
GCP_MEDIA_PROCESSING_TASK_URL=
GCP_SOCIAL_PUBLISH_TASK_URL=
GCP_VIDEO_RENDER_TASK_URL=https://www.getugcpilot.com/api/internal/jobs/launch-render
GCP_VIDEO_RENDER_JOB_NAME=ugc-video-render-job
GCP_VIDEO_RENDER_JOB_LOCATION=us-central1
GCP_VIDEO_RENDER_JOB_TIMEOUT_SECONDS=3600
# Optional common worker URL when all job types share one Cloud Run service.
GCP_BACKGROUND_JOB_TASK_URL=
GCP_BACKGROUND_JOB_TASK_AUDIENCE=
GCP_JOB_RECOVERY_AUDIENCE=https://getugcpilot.com/api/internal/jobs/recover
# Optional override; otherwise APP_BASE_URL/UGC_INTERNAL_APP_URL is used with
# /api/internal/schedules/dispatch.
GCP_SOCIAL_PUBLISH_DISPATCH_URL=
GCP_SOCIAL_PUBLISH_DISPATCH_AUDIENCE=
# Required on Vercel or any non-GCP runtime. Paste the ugc-app-sa service-account JSON directly,
# or use the split email/private-key alternative below. Do not use
# GOOGLE_APPLICATION_CREDENTIALS on Vercel unless it points to a real file.
GOOGLE_CLOUD_CREDENTIALS_JSON=
GOOGLE_CLOUD_CLIENT_EMAIL=
GOOGLE_CLOUD_PRIVATE_KEY=
# Optional dedicated HMAC secret for short-lived protected Hook previews.
# When omitted, a domain-separated key is derived from SUPABASE_SERVICE_ROLE_KEY.
HOOK_VIDEO_PREVIEW_SECRET=
# Server-only rollout switch for Hook ideas in Trending. Missing means disabled.
# Keep false in production. Set true in .env.local for local Hook testing.
TRENDING_HOOK_VIDEOS_ENABLED=false

# Per-worker Cloud Tasks configuration.
# Example Carousel worker:
# WORKER_TRANSPORT=cloud-tasks
# WORKER_QUEUE_NAME=carousel
# WORKER_JOB_TYPES=generate_carousel
# Example video render worker:
# WORKER_QUEUE_NAME=video-render
# WORKER_JOB_TYPES=render_edit_video,render_schedule_combination
# Example social publish worker:
# WORKER_QUEUE_NAME=social-publish
# WORKER_JOB_TYPES=publish_social_post
# SOCIAL_RECONCILIATION_ENABLED=false
WORKER_TRANSPORT=cloud-tasks
WORKER_QUEUE_NAME=
WORKER_JOB_TYPES=

# Durable social publishing retries and database reconciliation.
SOCIAL_PUBLISH_MAX_ATTEMPTS=4
SOCIAL_PUBLISH_RETRY_BASE_SECONDS=30
SOCIAL_PUBLISH_RETRY_MAX_SECONDS=900
SOCIAL_RECONCILIATION_ENABLED=true
SOCIAL_RECONCILIATION_BATCH_SIZE=10
SOCIAL_RECONCILIATION_INTERVAL_SECONDS=15
# GCP worker image/canary tooling.
GCP_WORKER_ARTIFACT_REPOSITORY=ugc-worker
GCP_WORKER_IMAGE_NAME=ugc-worker
GCP_WORKER_IMAGE_TAG=
GCP_WORKER_CANARY_JOB_NAME=ugc-worker-canary-test
GCP_VIDEO_RENDER_TEST_SOURCE_URL=
GCP_VIDEO_RENDER_TEST_USER_ID=
GCP_VIDEO_RENDER_TEST_PROJECT_ID=

NEXT_PUBLIC_FIREBASE_API_KEY="your_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_app_domain.com"
NEXT_PUBLIC_FIREBASE_AUTH_HELPER_DOMAIN="your_project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_app_id"
AI_STUDIO_ALLOWED_EMAILS="ugcpilot2026@gmail.com"
