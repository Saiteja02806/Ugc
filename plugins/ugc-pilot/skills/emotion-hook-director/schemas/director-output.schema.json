{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Emotion hook direction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ready_video_prompt",
    "duration_seconds",
    "motion_timeline",
    "overlay_text",
    "audio_plan"
  ],
  "properties": {
    "ready_video_prompt": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "motion_timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start_seconds",
          "end_seconds",
          "action"
        ],
        "properties": {
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "overlay_text": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "audio_plan": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "emotion_choice": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
