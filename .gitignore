# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.trigger
/worker/dist/
/worker/node_modules/

# production
/build

# misc
.DS_Store
*.pem
*.log
/.agents/
/.codex/
/.chrome-carousel-upgrade-check/
/.tmp/
/tmp/
/tmp-logs/
/local-run-logs/
/carousel-*.png
/carousel-*.webp

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
