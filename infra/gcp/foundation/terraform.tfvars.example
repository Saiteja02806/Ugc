project_id     = "ugcsaas"
project_number = "58051192797"
region         = "us-central1"
environment    = "prod"
name_prefix    = "ugc"

# Enable after the recovery route and Cloud Tasks worker URLs are deployed.
enable_background_job_recovery_scheduler = false
background_job_recovery_url               = "https://getugcpilot.com/api/internal/jobs/recover"
background_job_recovery_schedule          = "*/5 * * * *"

# Bucket names are globally unique. Change this if Terraform reports it is taken.
media_bucket_name     = "ugcsaas-media"
media_bucket_location = "US"

# Keep true while testing-phase media URLs are publicly readable.
media_bucket_public_read = false

# Keep false while testing with direct GCS URLs to avoid load-balancer costs.
# Set true when the custom media domain and CDN are needed.
enable_media_cdn = false

# Used only when enable_media_cdn is true. The managed certificate becomes
# ACTIVE only after DNS resolves to the CDN IP.
cdn_domain_names = ["media.getugcpilot.com"]

# These containers remain managed only to prevent accidental deletion from
# Terraform state. Trigger.dev runtime usage has been removed.
retained_legacy_secret_ids = [
  "trigger-access-token",
  "trigger-secret-key"
]
