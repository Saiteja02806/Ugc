{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UGC hook text",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "hooks"
  ],
  "properties": {
    "mode": {
      "enum": [
        "generate",
        "transcribe",
        "review"
      ]
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "platform": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "source_quality_note": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "hooks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "Hook",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "family",
          "evidence_status"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "family": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence_status": {
            "enum": [
              "verified",
              "user_stated",
              "illustrative",
              "uncertain"
            ]
          },
          "text_overlay_lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "proof_or_demo_beat": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "test_hypothesis": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "score_out_of_100": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "source_reference": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "classification": {
            "enum": [
              "full_hook",
              "subtitle_fragment",
              "interface_text",
              "uncertain"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uncertainty_notes": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
