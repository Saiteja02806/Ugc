project_id  = "ugcsaas"
region      = "us-central1"
environment = "prod"

# Keep false until:
# - a worker image has been pushed after the Cloud Run health listener change;
# - Secret Manager has enabled versions for the listed Supabase and AI secrets;
# - GCS media public read has been verified for generated testing-phase assets;
# - you are ready to test AI generation intentionally.
enable_ai_generation_worker = false

# Example after running npm run worker:gcp:image:push -- --cloud-build:
# worker_image_uri = "us-central1-docker.pkg.dev/ugcsaas/ugc-worker/ugc-worker:worker-gcp-20260718143000"
worker_image_uri = ""

worker_service_account_email = "ugc-worker-sa@ugcsaas.iam.gserviceaccount.com"
service_name                 = "ugc-ai-generation-worker"
queue_name                   = "ai-generation"
worker_job_types             = "generate_avatar,generate_image,generate_hook_video,generate_trending_hook_copy,hook_text_generation,wall_text_content_plan_generation,wall_text_generation,media_analysis,analytics_sync,carousel_content_plan_generation,test_worker_job"

worker_visibility_timeout_seconds = 1800
# Start only when Cloud Tasks has work. Ten is the initial burst ceiling; keep
# it aligned with foundation/cloud-tasks.tf and confirmed AI provider quotas.
min_instance_count                = 0
max_instance_count                = 10
request_timeout_seconds           = 1800
cpu                               = "2"
memory                            = "4Gi"
container_port                    = 8080

storage_provider            = "gcp"
gcp_storage_bucket          = "ugcsaas-media"
gcp_storage_public_base_url = "https://storage.googleapis.com/ugcsaas-media"

openai_api_key_secret_id = "openai-api-key"
openai_image_model       = "gpt-image-2"
gemini_image_model       = "gemini-3.1-flash-image"
gemini_omni_model        = "gemini-omni-flash-preview"
gemini_api_key_secret_id = "gemini-api-key"
runwayml_api_secret_id   = "runwayml-api-secret"
runway_daily_credit_limit = 100
internal_app_url          = "https://www.getugcpilot.com"
scheduling_secret_id     = "ugc-internal-scheduling-secret"

worker_version    = "worker-gcp"
worker_git_commit = "unknown"
