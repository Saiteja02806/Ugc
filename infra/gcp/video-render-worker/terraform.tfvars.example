project_id  = "ugcsaas"
region      = "us-central1"
environment = "prod"

# Keep false until:
# - a worker image has been pushed after the Cloud Run health listener change;
# - Secret Manager has enabled versions for supabase-url,
#   supabase-service-role-key, and ugc-internal-scheduling-secret;
# - GCS media public read has been enabled for the testing cutover.
enable_video_render_worker = false

# Example after running npm run worker:gcp:image:push -- --cloud-build:
# worker_image_uri = "us-central1-docker.pkg.dev/ugcsaas/ugc-worker/ugc-worker:worker-gcp-20260718143000"
worker_image_uri = ""

worker_service_account_email = "ugc-worker-sa@ugcsaas.iam.gserviceaccount.com"
service_name                 = "ugc-video-render-worker"
pubsub_subscription_name     = "ugc-video-render-sub"
queue_name                   = "video-render"
worker_job_types             = "render_edit_video,render_schedule_combination"

worker_poll_max_messages          = 1
worker_poll_wait_seconds          = 20
worker_visibility_timeout_seconds = 900
min_instance_count                = 1
max_instance_count                = 1
request_timeout_seconds           = 300
cpu                               = "2"
memory                            = "4Gi"
container_port                    = 8080

storage_provider            = "gcp"
gcp_storage_bucket          = "ugcsaas-media"
gcp_storage_public_base_url = "https://storage.googleapis.com/ugcsaas-media"

internal_app_url    = "https://getugcpilot.com"
scheduling_secret_id = "ugc-internal-scheduling-secret"
worker_version      = "worker-gcp"
worker_git_commit   = "unknown"
